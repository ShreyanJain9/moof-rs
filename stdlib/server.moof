;; ═══════════════════════════════════════════════════════════════════════
;; Server — REPL protocol backend
;;
;; A MoofServer handles protocol messages from any frontend.
;; Every response is a table with at least {status: "ok"/"error"}.
;; ═══════════════════════════════════════════════════════════════════════

(class MoofServer (fields repl)

  (method initialize ()
    (set! repl [MoofREPL new]))

  ;; ── Evaluation ─────────────────────────────────────────────────────

  (method handle-eval: (source)
    (try
      (let ((result [repl eval: source]))
        {status: "ok",
         value: result,
         display: (format "~a" result),
         type: [[result class] name]})
      (catch e
        {status: "error", message: [e message]})))

  (method handle-parse: (source)
    (try
      {status: "ok", ast: [repl parse: source]}
      (catch e
        {status: "error", message: [e message]})))

  (method handle-pretty-print: (expr)
    {status: "ok", source: [repl pretty-print: expr]})

  ;; ── Class introspection ────────────────────────────────────────────

  (method handle-classes ()
    (let ((classes (all-classes)))
      {status: "ok",
       classes: (map { |cls|
         {name: [cls name],
          superclass: (if (nil? [cls superclass]) nil [[cls superclass] name]),
          fields: [cls all-fields],
          method-count: [[cls methods] length]} } classes)}))

  (method handle-class-detail: (cls)
    {status: "ok",
     name: [cls name],
     superclass: (if (nil? [cls superclass]) nil [[cls superclass] name]),
     fields: [cls all-fields],
     hierarchy: (map { |c| [c name] } [cls hierarchy]),
     methods: (map { |m|
       {name: m,
        params: [cls method-params: m],
        source: [cls method-source: m]} } [cls methods])})

  (method handle-method-source: (cls selector)
    (let ((src [cls method-source: selector]))
      (if (nil? src)
        {status: "error", message: (format "No method ~a on ~a" selector [cls name])}
        {status: "ok", source: src})))

  ;; ── Object inspection ──────────────────────────────────────────────

  (method handle-inspect: (obj)
    (let ((cls [obj class]))
      {status: "ok",
       class: [cls name],
       display: (format "~a" obj),
       fields: (let ((field-names [cls all-fields]))
                 (if (nil? field-names) (list)
                   (map { |f| {name: f, value: (format "~a" [obj send: f])} }
                        field-names))),
       methods: [cls methods]}))

  ;; ── Environment ────────────────────────────────────────────────────

  (method handle-env ()
    {status: "ok",
     globals: (all-globals),
     macros: (all-macros),
     protocols: (all-protocols),
     class-count: (length (all-classes))})

  ;; ── Image ──────────────────────────────────────────────────────────

  (method handle-save: (path)
    (try
      (do (save-image path) {status: "ok", path: path})
      (catch e {status: "error", message: [e message]})))

  (method handle-load: (path)
    (try
      (do (require path) {status: "ok", path: path})
      (catch e {status: "error", message: [e message]})))

  ;; ── Stdio protocol loop ────────────────────────────────────────────

  (method run-stdio ()
    (define running true)
    [{ || running } whileTrue: { ||
      (let ((line (__primitive io_read_line)))
        (if (or (nil? line) (= [line trim] ""))
          (set! running false)
          (let ((result [self handle-eval: [line trim]]))
            (print [result to_json]))))}]))
