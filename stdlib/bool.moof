;; ═══════════════════════════════════════════════════════════════════════
;; Bool — TrueClass, FalseClass, and NilClass methods
;;
;; NilClass MUST be loaded before collections.moof because Cons methods
;; like map: recurse to nil (the empty list terminator).
;; ═══════════════════════════════════════════════════════════════════════

;; ── TrueClass ────────────────────────────────────────────────────────

(class TrueClass
  (method not () false)
  (method to_s () "true")
  (method nil? () false)

  (method and: (other) other)
  (method or: (other) self)
  (method ifTrue: (block) [block value])
  (method ifFalse: (block) nil)
  (method ifTrue:ifFalse: (tBlock fBlock) [tBlock value])
  (method ifNil: (block) nil)
  (method ifNotNil: (block) [block value: self]))

;; ── FalseClass ───────────────────────────────────────────────────────

(class FalseClass
  (method not () true)
  (method to_s () "false")
  (method nil? () false)

  (method and: (other) self)
  (method or: (other) other)
  (method ifTrue: (block) nil)
  (method ifFalse: (block) [block value])
  (method ifTrue:ifFalse: (tBlock fBlock) [fBlock value])
  (method ifNil: (block) nil)
  (method ifNotNil: (block) [block value: self]))

;; ── NilClass ─────────────────────────────────────────────────────────
;; Nil is the empty list terminator. It must respond to list methods
;; that return empty results, so Cons recursion terminates properly.

(class NilClass
  (method nil? () true)
  (method empty? () true)
  (method length () 0)
  (method to_s () "nil")

  (method ifNil: (block) [block value])
  (method ifNotNil: (block) nil)
  (method ifTrue: (block) nil)
  (method ifFalse: (block) [block value])
  (method ifTrue:ifFalse: (tBlock fBlock) [fBlock value])

  ;; List-compatible methods so Cons recursion terminates at nil
  (method map: (f) (list))
  (method filter: (f) (list))
  (method each: (f) nil)
  (method any: (f) false)
  (method all: (f) true)
  (method none: (f) true)
  (method reverse () (list))
  (method flatten () (list))
  (method take: (n) (list))
  (method drop: (n) (list))
  (method contains: (x) false)
  (method sort () (list))
  (method uniq () (list))
  (method join: (sep) "")
  (method reduce:init: (f init) init)
  (method sort_by: (f) (list))
  (method append: (other) other)
  (method zip: (other) (list))
  (method flat-map: (f) (list))
  (method compact () (list))
  (method enumerate () (list)))
