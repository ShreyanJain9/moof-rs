;; ═══════════════════════════════════════════════════════════════════════
;; Moof Standard Library — self-hosting core
;;
;; This file IS the language. Everything here is written in Moof itself,
;; running on top of a minimal set of Rust primitives.
;;
;; Built-in type methods (length, uppercase, map:, filter:, etc.) are
;; registered in Rust on their classes. This stdlib provides:
;;   - Functional-style wrappers (map, filter, reduce, etc.)
;;   - Higher-order function utilities (compose, pipe, partial, etc.)
;;   - Math & numeric utilities
;;   - ADTs (Option, Result, Pair)
;;   - Protocols and macros
;;   - Built-in type extensions (methods written in Moof)
;; ═══════════════════════════════════════════════════════════════════════


;; ── Core Logic ─────────────────────────────────────────────────────

(define (not x)
  (if x false true))

;; ── Functional-Style Wrappers ──────────────────────────────────────
;; These bridge () and [] by letting you write (map f lst) instead of
;; [lst map: f]. They exist because functional-style is idiomatic for
;; higher-order operations.

(define (length x)    [x length])
(define (reverse lst) [lst reverse])
(define (sort lst)    [lst sort])
(define (flatten lst) [lst flatten])
(define (empty? x)    [x empty?])
(define (first lst)   [lst first])
(define (last lst)    [lst last])

(define (map f lst)       [lst map: f])
(define (filter pred lst) [lst filter: pred])
(define (reduce f init lst) [lst reduce: f init: init])
(define (for-each f lst)  [lst each: f])

(define (take n lst)   [lst take: n])
(define (drop n lst)   [lst drop: n])
(define (zip a b)      [a zip: b])
(define (nth i lst)    [lst at: i])

;; ── Type Checks ───────────────────────────────────────────────────

(define (number?   x) (let ((t (type-of x))) (if (= t "Integer") true (= t "Float"))))
(define (integer?  x) (= (type-of x) "Integer"))
(define (float?    x) (= (type-of x) "Float"))
(define (string?   x) (= (type-of x) "String"))
(define (list?     x) (= (type-of x) "List"))
(define (nil?      x) (= (type-of x) "Nil"))
(define (bool?     x) (= (type-of x) "Bool"))
(define (function? x) (= (type-of x) "Function"))
(define (symbol?   x) (= (type-of x) "Symbol"))

;; ── Dynamic Message Send ──────────────────────────────────────────

(define (send receiver selector . args)
  (apply __send (cons receiver (cons selector args))))

(define (to-string x) [x to_s])

;; ── Assertion ─────────────────────────────────────────────────────

(define (assert condition)
  (if condition true (error "Assertion failed")))

(define (assert-equal expected actual)
  (if (= expected actual)
    true
    (error (format "Assertion failed: expected ~a, got ~a" expected actual))))

;; ── Identity and Composition ──────────────────────────────────────

(define (identity x) x)
(define (compose f g) (lambda (x) (f (g x))))
(define (flip f) (lambda (a b) (f b a)))
(define (constantly x) (lambda (. args) x))
(define (complement pred) (lambda (x) (not (pred x))))

(define (pipe . fns)
  (lambda (x) (reduce { |acc f| (f acc) } x fns)))

(define (juxt . fns)
  (lambda (x) (map { |f| (f x) } fns)))

(define (partial f . bound)
  (lambda (. args) (apply f (append bound args))))

;; ── Numeric Utilities ─────────────────────────────────────────────

(define (square x) (* x x))
(define (cube x)   (* x x x))
(define (abs x)    (if (< x 0) (- x) x))
(define (max a b)  (if (> a b) a b))
(define (min a b)  (if (< a b) a b))
(define (even? n)  (= (% n 2) 0))
(define (odd? n)   (not (even? n)))
(define (between? n lo hi) (if (>= n lo) (<= n hi) false))
(define (clamp n lo hi) (max lo (min hi n)))
(define (gcd a b) (if (= b 0) a (gcd b (% a b))))
(define (lcm a b) (/ (* a b) (gcd a b)))

(define (factorial n)
  (if (<= n 1) 1 (* n (factorial (- n 1)))))

(define (power base exp)
  (if (= exp 0) 1
    (if (even? exp)
      (let ((half (power base (/ exp 2)))) (* half half))
      (* base (power base (- exp 1))))))

(define (sum lst)     (reduce + 0 lst))
(define (product lst) (reduce * 1 lst))

;; ── Math Constants ────────────────────────────────────────────────

(define pi 3.141592653589793)
(define e  2.718281828459045)
(define (degrees->radians d) (* d (/ pi 180)))
(define (radians->degrees r) (* r (/ 180 pi)))

;; ── List Utilities ────────────────────────────────────────────────

(define (second lst) [lst at: 1])
(define (third  lst) [lst at: 2])

(define (any? pred lst)  [lst any: pred])
(define (all? pred lst)  [lst all: pred])
(define (none? pred lst) [lst none: pred])

(define (find pred lst)
  (if (empty? lst) nil
    (if (pred (car lst)) (car lst)
      (find pred (cdr lst)))))

(define (append . lists)
  (reduce { |acc lst|
    (reduce { |a x| (cons x a) } acc (reverse lst))
  } (list) (reverse lists)))

(define (zip-with f lst1 lst2)
  (if (if (empty? lst1) true (empty? lst2))
    (list)
    (cons (f (car lst1) (car lst2))
          (zip-with f (cdr lst1) (cdr lst2)))))

(define (repeat x n)
  (if (<= n 0) (list) (cons x (repeat x (- n 1)))))

(define (partition pred lst)
  (list (filter pred lst) (filter (complement pred) lst)))

(define (frequencies lst)
  (reduce
    { |counts x|
      (let ((n ([counts at: x])))
        [counts put: x value: (if (nil? n) 1 (+ n 1))])}
    {}
    lst))

(define (sort-by key lst)   [lst sortBy: key])
(define (sum-by key lst)    (sum (map key lst)))
(define (max-by key lst)
  (reduce { |best x| (if (> (key x) (key best)) x best) } (car lst) (cdr lst)))
(define (min-by key lst)
  (reduce { |best x| (if (< (key x) (key best)) x best) } (car lst) (cdr lst)))

(define (chunk-by n lst)
  (if (if (empty? lst) true (<= n 0))
    (list)
    (cons (take n lst) (chunk-by n (drop n lst)))))

(define (iterate f x n)
  (if (<= n 0) (list) (cons x (iterate f (f x) (- n 1)))))

(define (index-of pred lst)
  (define (go lst i)
    (if (empty? lst) -1
      (if (pred (car lst)) i
        (go (cdr lst) (+ i 1)))))
  (go lst 0))

(define (flat-map f lst) (flatten (map f lst)))

;; ── String Utilities ──────────────────────────────────────────────

(define (string-empty? s) (= [s length] 0))
(define (string-join sep lst) (if (empty? lst) "" [lst join: sep]))
(define (words s) (filter (complement string-empty?) [[s trim] split: " "]))
(define (lines s) [s split: "\n"])

(define (string-concat . strs)
  (reduce { |acc s| [acc concat: (to-string s)] } "" strs))

(define (string-repeat s n)
  (if (<= n 0) "" (string-concat s (string-repeat s (- n 1)))))

;; ── Memoize ───────────────────────────────────────────────────────

(define (memoize f)
  (let ((cache {}))
    (lambda (x)
      (let ((cached ([cache at: x])))
        (if (not (nil? cached))
          cached
          (let ((result (f x)))
            (set! cache [cache put: x value: result])
            result))))))

;; ── ADT Types ─────────────────────────────────────────────────────

(type Option (Some value) None)
(type Result (Ok value) (Err reason))
(type Pair   (Pair fst snd))

;; ── Option Helpers ────────────────────────────────────────────────

(define (some? x) (match x ((Some _) true) (_ false)))
(define (unwrap opt default) (match opt ((Some v) v) (_ default)))
(define (option-map f opt) (match opt ((Some v) (Some (f v))) (_ None)))
(define (option-flat-map f opt) (match opt ((Some v) (f v)) (_ None)))
(define (option-filter pred opt)
  (match opt ((Some v) (if (pred v) opt None)) (_ None)))

;; ── Result Helpers ────────────────────────────────────────────────

(define (ok? x)  (match x ((Ok _) true) (_ false)))
(define (err? x) (match x ((Err _) true) (_ false)))
(define (unwrap-ok res default) (match res ((Ok v) v) (_ default)))
(define (unwrap-err res default) (match res ((Err e) e) (_ default)))
(define (result-map f res) (match res ((Ok v) (Ok (f v))) ((Err e) (Err e))))
(define (result-flat-map f res) (match res ((Ok v) (f v)) ((Err e) (Err e))))
(define (try-call f . args) (try (Ok (apply f args)) (catch e (Err e))))

;; ── Pair Helpers ──────────────────────────────────────────────────

(define (fst p) (match p ((Pair a _) a)))
(define (snd p) (match p ((Pair _ b) b)))
(define (map-fst f p) (match p ((Pair a b) (Pair (f a) b))))
(define (map-snd f p) (match p ((Pair a b) (Pair a (f b)))))

;; ── Protocols ─────────────────────────────────────────────────────

(protocol Countable  length)
(protocol Iterable   map: filter: each:)
(protocol Comparable >)
(protocol Showable   to_s)

;; ── Macros ────────────────────────────────────────────────────────

(defmacro unless (cond body) `(if (not ,cond) ,body nil))
(defmacro when (cond body) `(if ,cond ,body nil))

;; ── Built-in Type Extensions (methods written in Moof) ────────────

(class Integer
  (method even? [] (= (% self 2) 0))
  (method odd?  [] (not [self even?]))
  (method times: [f] (for-each f (range self)))
  (method to: [n] (range self (+ n 1)))
  (method downto: [n]
    (if (< self n) (list)
      (cons self [(- self 1) downto: n]))))

(class Float
  (method round: [places]
    (let ((factor (power 10 places)))
      (/ (* self factor) factor)))
  (method floor [] [self to_i])
  (method ceil  [] (if (= self [self to_i]) [self to_i] (+ [self to_i] 1))))

(class String
  (method empty?    [] (= [self length] 0))
  (method blank?    [] [self empty?])
  (method words     [] (filter { |w| (not [w empty?]) } [[self trim] split: " "]))
  (method lines     [] [self split: "\n"])
  (method repeat:   [n] (string-repeat self n))
  (method includes: [s] [self contains: s])
  (method first:    [n] [self slice: 0 length: n])
  (method last:     [n] [self slice: (- [self length] n) length: n]))

(class List
  (method sum       [] (reduce + 0 self))
  (method product   [] (reduce * 1 self))
  (method min       [] (reduce min (car self) (cdr self)))
  (method max       [] (reduce max (car self) (cdr self)))
  (method compact   [] (filter { |x| (not (nil? x)) } self))
  (method enumerate [] [self zip: (range [self length])])
  (method second    [] [self at: 1])
  (method third     [] [self at: 2])
  (method flat-map: [f] (flatten [self map: f]))
  (method count:    [pred] [self length]))

(class Map
  (method each: [f]
    (for-each { |k| (f k [self at: k]) } [self keys])
    nil)
  (method map-values: [f]
    (reduce { |acc k| [acc put: k value: (f [self at: k])] }
      {} [self keys]))
  (method select: [pred]
    (reduce { |acc k|
      (if (pred k [self at: k])
        [acc put: k value: [self at: k]]
        acc)}
      {} [self keys]))
  (method reject: [pred]
    [self select: { |k v| (not (pred k v)) }]))
