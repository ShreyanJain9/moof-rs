;; ═══════════════════════════════════════════════════════════════════════
;; Moof Prelude — boot entry point
;;
;; This file is loaded first by the interpreter. It requires all
;; stdlib modules in the correct order. The order matters:
;;
;; 1. core.moof    — Object base methods (to_s, nil?, ==, etc.)
;; 2. bool.moof    — TrueClass, FalseClass, NilClass control flow
;; 3. numeric.moof — Integer + Float methods
;; 4. string.moof  — String methods
;; 5. collections.moof — Cons (List) + Table methods
;; 6. closure.moof — Closure methods (whileTrue:, etc.)
;; 7. range.moof   — Range methods
;; 8. error.moof   — Error methods
;; 9. symbol.moof  — Symbol methods
;; 10. functional.moof — Functional wrappers, HOF, type checks
;; 11. math.moof   — Math constants + utilities
;; 12. adt.moof    — Option, Result, Pair ADTs
;; 13. macros.moof — when, unless, and other macros
;; ═══════════════════════════════════════════════════════════════════════

(require "core")
(require "bool")
(require "numeric")
(require "string")
(require "collections")
(require "closure")
(require "range")
(require "error")
(require "symbol")
(require "functional")
(require "math")
(require "adt")
(require "macros")
(require "conditions")
(require "repl")
(require "inspector")
(require "browser")
(require "json")
(require "system")
(require "server")
