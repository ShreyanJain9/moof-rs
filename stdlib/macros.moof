;; ═══════════════════════════════════════════════════════════════════════
;; Macros — syntactic sugar
;; ═══════════════════════════════════════════════════════════════════════

(defmacro unless (cond . body) `(if (not ,cond) (do ,@body) nil))
(defmacro when (cond . body) `(if ,cond (do ,@body) nil))

;; while — explicit loop form
(defmacro while (cond . body)
  `[{ || ,cond } whileTrue: { || (do ,@body) }])

;; dotimes — repeat N times with index
(defmacro dotimes (var n . body)
  `[,n times: (lambda (,var) ,@body)])

;; -> already exists as pipeline, but let's add ->> (thread-last)
;; and some other convenience forms

;; cond — multi-branch conditional (macro version, supplements the special form)
;; This provides a cleaner syntax when you want it
(defmacro cond* (. clauses)
  (define (expand cls)
    (if (nil? cls) 'nil
      (let ((clause (car cls))
            (rest (cdr cls)))
        (let ((test (car clause))
              (body (car (cdr clause))))
          (if (= test 'else)
            body
            `(if ,test ,body ,(expand rest)))))))
  (expand clauses))

;; assert-that — readable assertions
(defmacro assert-that (expr . message)
  (if (nil? message)
    `(if (not ,expr) (error (format "Assertion failed: ~a" (quote ,expr))) true)
    `(if (not ,expr) (error ,(car message)) true)))

;; ── Structured Bindings ──────────────────────────────────────────────

;; with-fields: bind object field values to local variables
;; Usage: (with-fields (x y) point (+ (* x x) (* y y)))
;; Note: requires fields to be accessible as methods on the object
(defmacro with-fields (fields obj . body)
  (let ((bindings (map { |f| (list f (list (quote __send) obj f)) } fields)))
    `(let ,bindings ,@body)))

;; ── Protocols ────────────────────────────────────────────────────────

(protocol Countable  length)
(protocol Iterable   map: filter: each:)
(protocol Comparable >)
(protocol Showable   to_s)

;; ── Default Traits (derive pattern) ──────────────────────────────────

(trait ComparableDefaults
  (method < (other) (not (or [self > other] (= self other))))
  (method >= (other) (or [self > other] (= self other)))
  (method <= (other) (not [self > other]))
  (method min: (other) (if [self <= other] self other))
  (method max: (other) (if [self >= other] self other)))

(trait ShowableDefaults
  (method inspect () [self to_s]))

(trait EnumerableDefaults
  ;; Requires: each: (the fundamental iterator)
  ;; Derives: map:, filter:, reduce:init:, any:, all:, none:, count:, to_list
  (method map: (f)
    (define result (list))
    [self each: { |x| (set! result (cons (f x) result)) }]
    (reverse result))
  (method filter: (f)
    (define result (list))
    [self each: { |x| (when (f x) (set! result (cons x result))) }]
    (reverse result))
  (method reduce:init: (f init)
    (define acc init)
    [self each: { |x| (set! acc (f acc x)) }]
    acc)
  (method any: (f)
    (define found false)
    [self each: { |x| (when (f x) (set! found true)) }]
    found)
  (method all: (f)
    (define ok true)
    [self each: { |x| (unless (f x) (set! ok false)) }]
    ok)
  (method none: (f) (not [self any: f]))
  (method count: (f)
    [self reduce: { |n x| (if (f x) (+ n 1) n) } init: 0])
  (method to_list ()
    (define result (list))
    [self each: { |x| (set! result (cons x result)) }]
    (reverse result)))

;; ── Destructuring ────────────────────────────────────────────────────

;; Destructure a list into named bindings
;; (let* ((a b c) (list 1 2 3)) body) → a=1, b=2, c=3
;; Note: uses let* not let to avoid conflict with built-in let
(defmacro let-list (bindings val . body)
  (let ((temp-sym '__destructure_temp))
    `(let ((,temp-sym ,val))
       ,(let ((result `(do ,@body)))
          (define (wrap-bindings names idx expr)
            (if (nil? names) expr
              `(let ((,(car names) [,temp-sym at: ,idx]))
                 ,(wrap-bindings (cdr names) (+ idx 1) expr))))
          (wrap-bindings bindings 0 result)))))

(trait HashableDefaults
  ;; Requires: hash, ==
  ;; These are already on Object, but this documents the protocol
  (method eql: (other) (= [self hash] [other hash])))
